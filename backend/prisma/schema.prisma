generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  socialId     String   @unique
  address      String
  privateKey   String?
  name         String
  province     String
  authMethod   String
  registeredAt DateTime @default(now())
  votes        Vote[]

  @@index([address])
}

model Vote {
  id        String   @id @default(uuid())
  userId    Int
  province  String
  electionId String
  txHash    String?  @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([province])
  @@index([electionId])
  @@index([createdAt])
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  tokenVersion Int      @default(0)
  role         String   @default("admin")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Relations for audits
  auditsAsActor  AdminAudit[] @relation("actor")
  auditsAsTarget AdminAudit[] @relation("target")

  @@index([username])
}

model AdminAudit {
  id            Int      @id @default(autoincrement())
  actorAdminId  Int?
  action        String
  targetAdminId Int?
  details       Json?
  ip            String?
  userAgent     String?
  createdAt     DateTime @default(now())

  actor  Admin? @relation("actor", fields: [actorAdminId], references: [id], onDelete: SetNull)
  target Admin? @relation("target", fields: [targetAdminId], references: [id], onDelete: SetNull)

  @@index([actorAdminId])
  @@index([targetAdminId])
  @@index([createdAt])
}
