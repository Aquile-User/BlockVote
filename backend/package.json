{
  "name": "meta-tx-voting-backend",
  "version": "1.0.0",
  "description": "Gasless voting system on MegaETH testnet via meta-transactions",
  "main": "api/index.js",
  "scripts": {
    "deploy": "npx hardhat run scripts/deploy.js --network megaeth",
    "setup:env": "node scripts/setupEnv.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "db:migrate:users": "node scripts/migrateUsersToPrisma.js",
    "db:copy-sqlite-to-postgres": "node scripts/copySqliteToPostgres.js",
    "db:clear-private-keys": "node scripts/clearPrivateKeys.js",
    "relayer": "nodemon relayer/index.js",
    "api": "nodemon api/index.js",
    "create:admin": "node scripts/createAdmin.js"
  },
  "dependencies": {
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "@prisma/client": "^6.12.0",
    "axios": "^1.9.0",
    "bcrypt": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "ethers": "^6.7.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.21.0",
    "prisma": "^6.12.0",
    "sqlite3": "^6.0.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^4.6.3"
  },
  "devDependencies": {
    "hardhat": "^2.16.0",
    "nodemon": "^3.1.14"
  }
}
