# BlockVote environment template
# Copy this file to `.env` and replace the placeholders with real values.

# Database (required for Prisma)
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?schema=public

# Blockchain connection
BLOCKCHAIN_RPC_URL=https://<RPC_HOST>/rpc
VOTING_CONTRACT_ADDRESS=0x<CONTRACT_ADDRESS>
RELAYER_PRIVATE_KEY=0x<RELAYER_PRIVATE_KEY_HEX>

# Server
API_PORT=3000
RELAYER_PORT=3001
NODE_ENV=development

# Runtime behavior
DEBUG=true
CACHE_TTL=30
MAX_RPC_RETRIES=3

# Optional CORS allowlist
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Legacy aliases kept for compatibility with older code paths
RPC_URL=${BLOCKCHAIN_RPC_URL}
CONTRACT_ADDRESS=${VOTING_CONTRACT_ADDRESS}
RELAYER_PK=${RELAYER_PRIVATE_KEY}
