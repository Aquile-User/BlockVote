# BlockVote environment template
# Copy this file to .env and replace the placeholders with real values.

# Database
# Required by Prisma.
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?schema=public

# Blockchain / Relayer
# Shared by the API, relayer and deployment scripts.
BLOCKCHAIN_RPC_URL=https://<RPC_HOST>/rpc
VOTING_CONTRACT_ADDRESS=0x<CONTRACT_ADDRESS>
RELAYER_PRIVATE_KEY=0x<RELAYER_PRIVATE_KEY_HEX>

# Server
# Ports used by the backend services.
API_PORT=3000
RELAYER_PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Runtime
# Used by the relayer and setup scripts.
MAX_RPC_RETRIES=3

# Admin auth
# JWT secret for the admin cookie/session.
ADMIN_JWT_SECRET=<GENERATE_A_STRONG_RANDOM_SECRET>
